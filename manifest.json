{
  "manifest_version": 3,
  "name": "Pomodoro Timer",
  "version": "1.0",
  "description": "A simple Pomodoro timer extension",
  "permissions": ["storage", "alarms"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon16.jpg",
      "48": "assets/icon48.jpg",
      "128": "assets/icon128.jpg"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "assets/icon16.jpg",
    "48": "assets/icon48.jpg",
    "128": "assets/icon128.jpg"
  }
}